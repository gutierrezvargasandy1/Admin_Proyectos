<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.mx.cbtis</groupId>
    <artifactId>Ejercicio5Cliente</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Ejercicio5Cliente</name>
    <description>Interfaz del Gestor de Proyectos</description>

    <properties>
        <!-- CAMBIO: Java 17 -> Java 21 (LTS) -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versiones explicitas de plugins compatibles con Java 21 -->
        <jacoco.version>0.8.12</jacoco.version>
        <surefire.version>3.2.5</surefire.version>
        <sonar.plugin.version>5.5.0.6356</sonar.plugin.version>
        <dependency-check.version>12.1.0</dependency-check.version>

        <!-- ATENCION DE VULNERABILIDADES (Dependency-Check): versiones parchadas de librerias
             transitivas, compatibles con Spring Boot 3.2 (sin cambiar la version de Spring Boot) -->
        <tomcat.version>10.1.61</tomcat.version>        
        <thymeleaf.version>3.1.4.RELEASE</thymeleaf.version>      <!-- CVE-2026-40477 y CVE-2026-40478 (9.0, SSTI) -->
        <spring-framework.version>6.1.14</spring-framework.version> <!-- CVE-2024-38820 -->

        <!-- Configuracion de SonarQube -->
        <sonar.projectKey>gestor-cliente</sonar.projectKey>
        <sonar.projectName>Gestor de Proyectos - Cliente (Frontend)</sonar.projectName>
        <!-- Se analiza Java + vistas Thymeleaf (HTML) + JavaScript propio -->
        <sonar.sources>src/main/java,src/main/resources</sonar.sources>
        <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Se excluye target y el codigo de terceros (Bootstrap, jQuery, Popper), mapas e imagenes -->
        <sonar.exclusions>**/target/**,**/static/css/bootstrap*,**/static/js/bootstrap*,**/static/js/jquery*,**/static/js/popper*,**/*.map,**/static/Images/**</sonar.exclusions>
        <!-- La cobertura JaCoCo aplica al codigo Java; las vistas y el JS no tienen pruebas unitarias JS -->
        <sonar.coverage.exclusions>**/Ejercicio5ClienteApplication.java,**/static/**,**/templates/**</sonar.coverage.exclusions>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Pruebas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ELIMINADO: org.webjars:bootstrap 5.3.3 (no se usaba: las vistas cargan Bootstrap desde static/css y static/js) -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Analisis de calidad con SonarQube (obligatorio) -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.plugin.version}</version>
            </plugin>

            <!-- Medicion de cobertura con JaCoCo -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- Clase de arranque: solo invoca SpringApplication.run -->
                        <exclude>com/mx/cbtis/Ejercicio5ClienteApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- El build FALLA si la cobertura baja del minimo -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Ejecucion de pruebas unitarias con Surefire -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>

            <!-- Escaneo de vulnerabilidades: dependencias Java y librerias JS (Retire.js) -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                        <format>XML</format>
                    </formats>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <!-- CVE clasificadas como NO APLICABLES / falsos positivos / riesgo aceptado, con justificacion -->
                    <suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
                    <skipTestScope>true</skipTestScope>
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <!-- Analiza los archivos del proyecto (incluye static/js) EXCLUYENDO las carpetas target -->
                    <scanSet>
                        <fileSet>
                            <directory>${project.basedir}</directory>
                            <excludes>
                                <exclude>**/target/**</exclude>
                            </excludes>
                        </fileSet>
                    </scanSet>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
